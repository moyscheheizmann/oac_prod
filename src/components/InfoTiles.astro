---
import { infoTiles, type TileColor } from "../data/site";

const background: Record<TileColor, string> = {
  cyan: "bg-oac-cyan",
  red: "bg-oac-red",
  orange: "bg-oac-orange",
};
---

<section id="infos" class="grid gap-0 sm:grid-cols-2 lg:grid-cols-3">
  {
    infoTiles.map((tile) => (
      <article class={`${background[tile.color]} p-6 lg:p-8`}>
        <h2 class="text-lg font-bold text-oac-navy">{tile.heading}</h2>

        {tile.body?.map((paragraph) => (
          <p class="mt-3 text-sm leading-relaxed text-white">{paragraph}</p>
        ))}

        {tile.items && (
          <ul class="mt-3 space-y-1 text-sm leading-relaxed text-white">
            {tile.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</section>
