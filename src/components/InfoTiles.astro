---
import { infoTiles, type TileColor } from "../data/site";

// Light cards with a thick frame in the tile's colour.
const frame: Record<TileColor, string> = {
  cyan: "border-oac-cyan",
  red: "border-oac-red",
  orange: "border-oac-orange",
};

const accent: Record<TileColor, string> = {
  cyan: "text-oac-cyan",
  red: "text-oac-red",
  orange: "text-oac-orange",
};
---

{/*
  Flip cards: the front shows only the heading, the back the full text.
  Hover turns a card on devices that can hover; a click or tap toggles it
  everywhere. Both faces share one grid cell, and the rows are 1fr, so every
  tile is as tall as the longest back.
*/}
<section
  id="infos"
  class="mx-auto my-10 grid max-w-6xl auto-rows-fr gap-4 px-4 sm:my-14 sm:grid-cols-2 lg:grid-cols-3"
>
  {
    infoTiles.map((tile, index) => (
      <article class="flip-card" data-flip-card>
        <div class="flip-card-inner">
          <div
            class={`flip-card-face border-[6px] bg-white ${frame[tile.color]} flex flex-col items-center justify-center p-6 text-center lg:p-8`}
          >
            <h2 class="font-display text-2xl text-oac-berry lg:text-3xl">
              <button
                type="button"
                aria-expanded="false"
                aria-controls={`info-${index}`}
                data-flip-toggle
                class="cursor-pointer text-balance focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oac-berry"
              >
                {tile.heading}
              </button>
            </h2>
            <span aria-hidden="true" class={`mt-4 text-2xl leading-none ${accent[tile.color]}`}>
              ↻
            </span>
          </div>

          <div
            id={`info-${index}`}
            inert
            class={`flip-card-face flip-card-back border-[6px] bg-white ${frame[tile.color]} p-6 lg:p-8`}
          >
            <p aria-hidden="true" class="font-display text-xl text-oac-berry">
              {tile.heading}
            </p>

            {tile.body?.map((paragraph) => (
              <p class="mt-3 text-sm leading-relaxed text-oac-ink">{paragraph}</p>
            ))}

            {tile.items && (
              <ul class="mt-3 space-y-1 text-sm leading-relaxed text-oac-ink">
                {tile.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .flip-card {
    perspective: 1200px;
    cursor: pointer;
  }

  .flip-card-inner {
    display: grid;
    height: 100%;
    transform-style: preserve-3d;
    /* Overshoots a little past the turn and settles back: a small bounce. */
    transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    /*
     * Taps go to the untransformed card instead. iOS Safari hit-tests the
     * turned 3D faces unreliably, which swallowed the tap to turn back.
     */
    pointer-events: none;
  }

  /* Both faces in the same cell, so the card takes the taller one's height. */
  .flip-card-face {
    grid-area: 1 / 1;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }

  .flip-card[data-flipped] .flip-card-inner {
    transform: rotateY(180deg);
  }

  @media (hover: hover) {
    .flip-card:hover .flip-card-inner {
      transform: rotateY(180deg);
    }
  }

  /* No spinning for reduced motion: swap the faces with a short fade. */
  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner,
    .flip-card[data-flipped] .flip-card-inner,
    .flip-card:hover .flip-card-inner {
      transform: none;
    }

    .flip-card-face {
      transition: opacity 0.2s ease-in-out;
    }

    .flip-card-back {
      transform: none;
      opacity: 0;
    }

    .flip-card[data-flipped] .flip-card-back {
      opacity: 1;
    }

    .flip-card[data-flipped] .flip-card-face:not(.flip-card-back) {
      opacity: 0;
    }

    @media (hover: hover) {
      .flip-card:hover .flip-card-back {
        opacity: 1;
      }

      .flip-card:hover .flip-card-face:not(.flip-card-back) {
        opacity: 0;
      }
    }
  }
</style>

<script>
  for (const card of document.querySelectorAll<HTMLElement>("[data-flip-card]")) {
    const toggle = card.querySelector<HTMLButtonElement>("[data-flip-toggle]");
    const back = card.querySelector<HTMLElement>(".flip-card-back");

    // The whole card is the click target; the button carries the state for
    // keyboard and screen reader users.
    card.addEventListener("click", () => {
      const flipped = !card.hasAttribute("data-flipped");
      card.toggleAttribute("data-flipped", flipped);
      toggle?.setAttribute("aria-expanded", String(flipped));
      if (back) back.inert = !flipped;
    });
  }
</script>
