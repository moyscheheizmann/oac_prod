---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Prize } from "../content.config";
import { formatDayHeading } from "../data/site";

interface Props {
  date: string;
  prizes: Prize[];
}

const { date, prizes } = Astro.props;

/**
 * Sponsor logos are optional: the old sponsor list has none for roughly a
 * quarter of the businesses, and those rows fall back to the company name.
 */
const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/sponsors/*.{png,jpg,jpeg,svg,webp,avif}",
  { eager: true },
);

function logoFor(name: string | null): ImageMetadata | undefined {
  if (!name) return undefined;
  return logos[`/src/assets/sponsors/${name}`]?.default;
}
---

<section class="mx-auto max-w-6xl px-4 py-8" id={`tag-${date}`}>
  <h2 class="font-display text-3xl font-bold text-oac-red sm:text-4xl">
    {formatDayHeading(date)}
  </h2>

  <ul class="mt-4 divide-y divide-oac-navy/15 border border-oac-navy/15 bg-white">
    {
      prizes.map((prize) => {
        const logo = logoFor(prize.logo);
        return (
          <li class="grid grid-cols-[5rem_1fr] gap-4 p-4 sm:grid-cols-[7rem_1fr_10rem] sm:gap-6">
            <ol class="space-y-0.5 font-bold tabular-nums text-oac-red">
              {prize.numbers.map((n: string) => (
                <li>{n}</li>
              ))}
            </ol>

            <div class="min-w-0">
              <p class="text-sm italic text-oac-ink/80">{prize.sponsor}</p>
              <p class="font-bold text-oac-navy">{prize.prize}</p>
              {prize.pickupAt && (
                <p class="mt-1 text-sm text-oac-ink/60">
                  Abzuholen bei: {prize.pickupAt}
                </p>
              )}
            </div>

            <div class="col-span-2 flex items-center justify-center bg-oac-navy/85 p-3 sm:col-span-1">
              {logo ? (
                <Image
                  src={logo}
                  alt={prize.sponsor}
                  widths={[160, 320]}
                  sizes="160px"
                  class="max-h-20 w-auto object-contain"
                  loading="lazy"
                />
              ) : (
                <span class="text-center text-sm font-bold text-white">
                  {prize.sponsor}
                </span>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
