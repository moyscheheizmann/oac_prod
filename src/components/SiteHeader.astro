---
import { site } from "../data/site";
import logo from "../assets/logo/ottenser-adventskalender-tribuehne.svg";
import tribuehneLogo from "../assets/logo/tribuehne-logo.png";
---

{/*
  The organiser's logo, right at the top of the page. It scrolls away; the
  red header below it stays. Its black lettering needs a light ground, so it
  sits on a cream strip rather than on the red.
*/}
<div class="bg-oac-paper">
  <div
    class="mx-auto flex max-w-6xl items-center justify-center gap-3 px-4 py-1.5 sm:justify-end"
  >
    <span class="text-xs text-oac-ink/70">Eine Aktion der</span>
    <a
      href="https://tribuehne.net/"
      class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oac-berry"
    >
      <img
        src={tribuehneLogo.src}
        width={tribuehneLogo.width}
        height={tribuehneLogo.height}
        alt="Circusschule TriBühne"
        class="h-10 w-auto sm:h-12"
      />
    </a>
  </div>
</div>

<header class="sticky top-0 z-40 bg-oac-berry">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:py-4">
    <a
      href="/"
      class="shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oac-paper"
    >
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt={site.title}
        class="h-14 w-auto sm:h-18 lg:h-22"
      />
    </a>

    <div class="ml-auto flex items-center gap-3">
      <button
        type="button"
        data-open-search
        class="rounded-full bg-oac-orange px-4 py-2 text-sm font-bold text-white transition hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oac-paper sm:px-6"
      >
        Losnummer eingeben
      </button>

      <button
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        data-menu-toggle
        class="flex h-10 w-10 shrink-0 flex-col items-center justify-center gap-[5px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oac-paper"
      >
        <span class="block h-[3px] w-7 rounded bg-oac-paper"></span>
        <span class="block h-[3px] w-7 rounded bg-oac-paper"></span>
        <span class="block h-[3px] w-7 rounded bg-oac-paper"></span>
      </button>
    </div>
  </div>

  <nav data-menu hidden class="border-t border-oac-paper/15 bg-oac-berry">
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3 font-bold text-oac-paper">
      {/* Absolute, so the anchors still reach the home page from a subpage. */}
      <li><a class="block py-1 hover:underline" href="/#kalender">Gewinnnummern</a></li>
      <li><a class="block py-1 hover:underline" href="/#infos">Wie funktioniert’s?</a></li>
      <li>
        <a class="block py-1 hover:underline" href="/sponsorenverzeichnis">
          Sponsorenverzeichnis
        </a>
      </li>
      <li><a class="block py-1 hover:underline" href="/kontakt">Kontakt</a></li>
    </ul>
  </nav>
  {/* Snow lying along the bottom edge of the header. */}
  <div aria-hidden="true" class="snow-edge pointer-events-none absolute inset-x-0 top-full h-3"></div>
</header>

<style>
  .snow-edge {
    background:
      radial-gradient(circle at 12px 0, var(--color-oac-paper) 11px, transparent 12px) 0 0 / 24px 12px
        repeat-x,
      radial-gradient(circle at 5px 0, var(--color-oac-paper) 6px, transparent 7px) 12px 0 / 24px 9px
        repeat-x;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.12));
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  toggle?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) menu?.removeAttribute("hidden");
    else menu?.setAttribute("hidden", "");
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
  });
</script>
