---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { logoFor } from "../lib/logos";
import { sponsorsPage } from "../data/site";
import { sponsorWebsites } from "../data/sponsorWebsites";

// Already sorted by name in the exporter; sorted again here so the page does
// not depend on the order the JSON happens to arrive in.
const sponsors = (await getCollection("sponsors")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "de"),
);

// The cards' frames cycle through the circus colours. A cycle of four
// (not three) keeps the three-column grid from turning into one colour per
// column: no card shares its colour with the one beside or above it.
const frames = ["border-oac-cyan", "border-oac-red", "border-oac-cyan", "border-oac-orange"];
---

<Layout
  title={`${sponsorsPage.heading} – Ottenser Adventskalender`}
  description="Alle Geschäfte und Betriebe, die den Ottenser Adventskalender mit Preisen unterstützen."
>
  <main class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-display text-3xl font-bold text-oac-berry sm:text-4xl">
      {sponsorsPage.heading}
    </h1>
    <p class="mt-4 font-display text-xl text-oac-red">{sponsorsPage.lead}</p>
    <p class="mt-2 max-w-2xl text-oac-ink/80">{sponsorsPage.thanks}</p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sponsors.map((sponsor, index) => {
          const logo = logoFor(sponsor.data.logo);
          const website = sponsorWebsites[sponsor.id];
          // The logo panel links to the sponsor's homepage when we know it.
          const Panel = website ? "a" : "div";
          const panelLink = website
            ? {
                href: website,
                target: "_blank",
                rel: "noopener",
                "aria-label": `${sponsor.data.name} – Website (öffnet in neuem Tab)`,
              }
            : {};
          return (
            <li
              class={`flex h-full flex-col overflow-hidden border-[5px] bg-white ${frames[index % frames.length]}`}
            >
              {/*
                Sponsors without a logo carry their name in the panel instead,
                so the name is never printed twice on the same card.
              */}
              <Panel
                {...panelLink}
                class:list={[
                  "logo-panel flex h-32 items-center justify-center p-4",
                  website && "logo-link",
                ]}
              >
                {logo ? (
                  <Image
                    src={logo}
                    alt={sponsor.data.name}
                    widths={[200, 400]}
                    sizes="200px"
                    class="max-h-24 w-auto object-contain"
                    loading="lazy"
                  />
                ) : (
                  <h2 class="text-center font-display text-2xl text-oac-berry">
                    {sponsor.data.name}
                  </h2>
                )}
                {website && (
                  <span aria-hidden="true" class="logo-link-icon">
                    ↗
                  </span>
                )}
              </Panel>

              <div class="border-t border-oac-ink/10 p-4">
                {logo && <h2 class="font-bold text-oac-berry">{sponsor.data.name}</h2>}
                {sponsor.data.address && (
                  <p class="mt-1 text-sm text-oac-ink/70">{sponsor.data.address}</p>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="mt-8 text-sm text-oac-ink/60">
      {sponsors.length} Unterstützer*innen
    </p>
  </main>
</Layout>

<style>
  .logo-panel {
    position: relative;
  }

  .logo-link {
    transition: background-color 0.2s;
  }

  .logo-link:hover {
    background-color: var(--color-oac-paper);
  }

  .logo-link:focus-visible {
    outline: 3px solid var(--color-oac-berry);
    outline-offset: -3px;
  }

  /*
   * Class names avoid the word "sponsor": ad-block filter lists hide elements
   * named like that, which emptied every linked card.
   *
   * A small corner arrow marks the cards that lead off-site.
   */
  .logo-link-icon {
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    font-size: 1rem;
    line-height: 1;
    color: var(--color-oac-red);
  }
</style>
