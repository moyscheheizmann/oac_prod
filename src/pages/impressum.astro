---
import Layout from "../layouts/Layout.astro";
import Missing from "../components/Missing.astro";
import { contact, credits, impressum } from "../data/site";

const illustrator = credits.find((credit) => credit.role === "Illustration")?.names;
---

<Layout
  title="Impressum – Ottenser Adventskalender"
  description="Impressum und Anbieterkennzeichnung des Ottenser Adventskalenders, Circusschule TriBühne e.V."
>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display text-3xl font-bold text-oac-navy sm:text-4xl">Impressum</h1>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Angaben gemäß § 5 DDG</h2>
      <address class="mt-3 space-y-1 not-italic text-oac-ink/80">
        <p class="font-bold text-oac-ink">{contact.organisation}</p>
        <p>{contact.street}</p>
        <p>{contact.city}</p>
      </address>
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Vertreten durch</h2>
      <p class="mt-3 text-oac-ink/80">
        {impressum.board ?? <Missing what="Vertretungsberechtigte(r) des Vereins" />}
      </p>
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Kontakt</h2>
      <dl class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-[max-content_1fr]">
        <dt class="font-bold text-oac-navy">Telefon</dt>
        <dd class="text-oac-ink/80">
          <a class="underline hover:no-underline" href={`tel:${contact.phoneHref}`}>
            {contact.phone}
          </a>
        </dd>
        <dt class="font-bold text-oac-navy">E-Mail</dt>
        <dd class="text-oac-ink/80">
          <a class="underline hover:no-underline" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        </dd>
      </dl>
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Registereintrag</h2>
      <dl class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-[max-content_1fr]">
        <dt class="font-bold text-oac-navy">Registergericht</dt>
        <dd class="text-oac-ink/80">
          {impressum.register ?? <Missing what="Registergericht, z. B. Amtsgericht Hamburg" />}
        </dd>
        <dt class="font-bold text-oac-navy">Registernummer</dt>
        <dd class="text-oac-ink/80">
          {impressum.registerNumber ?? <Missing what="Vereinsregisternummer, z. B. VR 12345" />}
        </dd>
      </dl>
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Umsatzsteuer-ID</h2>
      <p class="mt-3 text-oac-ink/80">
        {
          impressum.vatId ?? (
            <Missing what="Umsatzsteuer-ID nach § 27a UStG — falls der Verein keine hat, diesen Abschnitt löschen" />
          )
        }
      </p>
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">
        Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
      </h2>
      <p class="mt-3 text-oac-ink/80">
        {impressum.contentResponsible ?? <Missing what="Name und Anschrift der verantwortlichen Person" />}
      </p>
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Urheberrecht</h2>
      <p class="mt-3 leading-relaxed text-oac-ink/80">
        Alle auf dieser Website dargestellten Daten und Inhalte sind urheberrechtlich
        geschützt. Sie sind ausschließlich zur Information bestimmt und begründen kein
        Angebot zum Abschluss von Verträgen oder sonstigen Rechtsgeschäften. Jede
        Bearbeitung, Vervielfältigung, Verbreitung und/oder öffentliche Wiedergabe ohne
        schriftliche Genehmigung der {contact.organisation} stellt eine Verletzung des
        Urheberrechts dar.
      </p>
      {
        illustrator && (
          <p class="mt-3 leading-relaxed text-oac-ink/80">
            Die Illustrationen des Kalenders stammen von {illustrator}. Die Logos der
            Sponsoren sind Eigentum der jeweiligen Unternehmen.
          </p>
        )
      }
    </section>

    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold text-oac-navy">Haftung für Links</h2>
      <p class="mt-3 leading-relaxed text-oac-ink/80">
        Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir
        keinen Einfluss haben. Für die Inhalte der verlinkten Seiten ist stets der
        jeweilige Anbieter oder Betreiber der Seiten verantwortlich.
      </p>
    </section>
  </main>
</Layout>
