---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import InfoTiles from "../components/InfoTiles.astro";
import DayTable from "../components/DayTable.astro";
import { getOpenDays, getDoors } from "../lib/calendar";
import { site } from "../data/site";
import calendarArt from "../assets/hero/kalender-2026.jpg";

const days = await getOpenDays();
const doors = await getDoors();
---

<Layout>
  <main>
    {/*
      Hero: welcome text beside the yearly calendar artwork, on a sky-blue
      band that sets it off from the navy header. On phones the artwork comes
      first.
    */}
    <section class="bg-oac-sky py-6 sm:py-10">
      <div class="mx-auto max-w-6xl sm:px-4">
        <div class="grid overflow-hidden shadow-xl lg:grid-cols-[2fr_3fr]">
          <div
            class="order-2 flex flex-col items-center justify-center bg-oac-paper px-6 py-8 text-center sm:px-10 lg:order-1 lg:py-10"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-10 w-10 -rotate-12 fill-oac-orange/80"
            >
              <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
            </svg>

            <h1 class="mt-3 font-display text-3xl font-bold text-oac-navy sm:text-4xl">
              {site.welcome}
            </h1>

            {
              site.intro.map((paragraph) => (
                <p class="mt-4 text-[0.95rem] leading-relaxed text-oac-ink">{paragraph}</p>
              ))
            }
          </div>

          <Picture
            src={calendarArt}
            alt="Die Illustration des Ottenser Adventskalenders 2026: eine verschneite Ottenser Straßenecke voller Artist*innen, mit den Türchennummern 1 bis 24."
            widths={[640, 960, 1280, 1920, 2400]}
            sizes="(min-width: 1152px) 672px, (min-width: 1024px) 60vw, 100vw"
            formats={["avif", "webp"]}
            loading="eager"
            fetchpriority="high"
            pictureAttributes={{ class: "order-1 block lg:order-2" }}
            class="h-auto w-full lg:h-full lg:object-cover"
          />
        </div>
      </div>
    </section>

    <InfoTiles />

    <section id="kalender" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="font-display text-3xl font-bold text-oac-navy">Die Türchen</h2>
      <ol class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-8">
        {
          doors.map((door) =>
            door.open ? (
              <li>
                <a
                  href={`#tag-${door.date}`}
                  class="flex aspect-square items-center justify-center rounded bg-oac-cyan text-2xl font-bold text-white transition hover:brightness-95"
                >
                  {String(door.day).padStart(2, "0")}
                </a>
              </li>
            ) : (
              <li>
                <span
                  class="flex aspect-square items-center justify-center rounded bg-oac-navy/15 text-2xl font-bold text-oac-navy/40"
                  aria-label={`Türchen ${door.day} ist noch geschlossen`}
                >
                  {String(door.day).padStart(2, "0")}
                </span>
              </li>
            ),
          )
        }
      </ol>
    </section>

    {
      days.length === 0 ? (
        <p class="mx-auto max-w-4xl px-4 py-10 text-center font-display text-xl text-oac-navy">
          Das erste Türchen öffnet am 1. Dezember.
        </p>
      ) : (
        days
          .slice()
          .reverse()
          .map((day) => <DayTable date={day.data.date} prizes={day.data.prizes} />)
      )
    }
  </main>

</Layout>
