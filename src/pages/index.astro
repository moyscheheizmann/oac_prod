---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import InfoTiles from "../components/InfoTiles.astro";
import DayTable from "../components/DayTable.astro";
import { getOpenDays, getDoors } from "../lib/calendar";
import { site } from "../data/site";
import calendarArt from "../assets/hero/kalender-2026.jpg";

const days = await getOpenDays();
const doors = await getDoors();
---

<Layout>
  <main>
    {/* Hero: the yearly calendar artwork, shown whole. */}
    <section class="mx-auto max-w-6xl px-4 pt-6 pb-8">
      <Picture
        src={calendarArt}
        alt="Die Illustration des Ottenser Adventskalenders 2026: eine verschneite Ottenser Straßenecke voller Artist*innen, mit den Türchennummern 1 bis 24."
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="(min-width: 1152px) 1120px, calc(100vw - 2rem)"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full rounded-sm shadow-lg"
      />
    </section>

    {/* Navy band, echoing the artwork's night sky. */}
    <section class="bg-oac-navy">
      <div class="mx-auto max-w-5xl px-4 py-10 text-center sm:px-8 sm:py-12">
        {
          site.intro.map((paragraph) => (
            <p class="mt-4 font-display text-lg leading-relaxed text-oac-paper first:mt-0 lg:text-xl">
              {paragraph}
            </p>
          ))
        }
      </div>
    </section>

    <InfoTiles />

    <section id="kalender" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="font-display text-3xl font-bold text-oac-navy">Die Türchen</h2>
      <ol class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-8">
        {
          doors.map((door) =>
            door.open ? (
              <li>
                <a
                  href={`#tag-${door.date}`}
                  class="flex aspect-square items-center justify-center rounded bg-oac-cyan text-2xl font-bold text-white transition hover:brightness-95"
                >
                  {String(door.day).padStart(2, "0")}
                </a>
              </li>
            ) : (
              <li>
                <span
                  class="flex aspect-square items-center justify-center rounded bg-oac-navy/15 text-2xl font-bold text-oac-navy/40"
                  aria-label={`Türchen ${door.day} ist noch geschlossen`}
                >
                  {String(door.day).padStart(2, "0")}
                </span>
              </li>
            ),
          )
        }
      </ol>
    </section>

    {
      days.length === 0 ? (
        <p class="mx-auto max-w-4xl px-4 py-10 text-center font-display text-xl text-oac-navy">
          Das erste Türchen öffnet am 1. Dezember.
        </p>
      ) : (
        days
          .slice()
          .reverse()
          .map((day) => <DayTable date={day.data.date} prizes={day.data.prizes} />)
      )
    }
  </main>

</Layout>
