---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import DoorMotif from "../components/DoorMotif.astro";
import InfoTiles from "../components/InfoTiles.astro";
import DayTable from "../components/DayTable.astro";
import { getOpenDays, getDoors, berlinToday } from "../lib/calendar";
import { site, calendarYear } from "../data/site";
import calendarArt from "../assets/hero/kalender-2026.jpg";

const days = await getOpenDays();
const doors = await getDoors();
const seasonStarted = berlinToday() >= `${calendarYear}-12-01`;
---

<Layout>
  <main>
    {/*
      Hero: welcome text beside the yearly calendar artwork, on a fir-green
      band with a light fall of snow. On phones the artwork comes first.
    */}
    <section class="hero-band py-8 sm:py-12">
      <div class="mx-auto max-w-6xl sm:px-4">
        <div class="grid overflow-hidden shadow-xl lg:grid-cols-[2fr_3fr]">
          <div
            class="order-2 flex flex-col items-center justify-center bg-oac-paper px-6 py-8 text-center sm:px-10 lg:order-1 lg:py-10"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-10 w-10 -rotate-12 fill-oac-orange/80"
            >
              <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
            </svg>

            <h1 class="mt-3 font-display text-3xl font-bold text-oac-berry sm:text-4xl">
              {site.welcome}
            </h1>

            {
              site.intro.map((paragraph) => (
                <p class="mt-4 text-[0.95rem] leading-relaxed text-oac-ink">{paragraph}</p>
              ))
            }
          </div>

          <Picture
            src={calendarArt}
            alt="Die Illustration des Ottenser Adventskalenders 2026: eine verschneite Ottenser Straßenecke voller Artist*innen, mit den Türchennummern 1 bis 24."
            widths={[640, 960, 1280, 1920, 2400]}
            sizes="(min-width: 1152px) 672px, (min-width: 1024px) 60vw, 100vw"
            formats={["avif", "webp"]}
            loading="eager"
            fetchpriority="high"
            pictureAttributes={{ class: "order-1 block lg:order-2" }}
            class="h-auto w-full lg:h-full lg:object-cover"
          />
        </div>
      </div>
    </section>

    <InfoTiles />

    <section id="kalender" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="font-display text-3xl font-bold text-oac-berry">Die Türchen</h2>
      {/*
        Türchen styled after the printed calendar: navy with yellow numbers
        and a perforated edge. Opened doors swing open on their date, show a
        small motif behind them and link to that day's prizes; the rest stay
        shut. The nightly rebuild opens the next one.
      */}
      <ol class="mt-4 grid grid-cols-4 gap-3 sm:grid-cols-6 lg:grid-cols-8">
        {
          doors.map((door) => {
            const number = String(door.day);
            return door.open && door.hasPrizes ? (
              <li class="door door-open">
                <a href={`#tag-${door.date}`} aria-label={`Türchen ${door.day}: Gewinne ansehen`}>
                  <DoorMotif day={door.day} />
                  <span class="door-panel">{number}</span>
                </a>
              </li>
            ) : door.open ? (
              // Open by date, but the numbers are not in yet: nothing to link to.
              <li class="door door-open">
                <span class="door-link">
                  <DoorMotif day={door.day} />
                  <span class="door-panel">
                    <span aria-hidden="true">{number}</span>
                    <span class="sr-only">Türchen {door.day}: Gewinnnummern folgen in Kürze</span>
                  </span>
                </span>
              </li>
            ) : (
              <li class="door">
                <span class="door-panel">
                  <span aria-hidden="true">{number}</span>
                  <span class="sr-only">Türchen {door.day} ist noch geschlossen</span>
                </span>
              </li>
            );
          })
        }
      </ol>
    </section>

    {
      days.length === 0 ? (
        <p class="mx-auto max-w-4xl px-4 py-10 text-center font-display text-xl text-oac-berry">
          {seasonStarted
            ? "Die Gewinnnummern folgen in Kürze."
            : "Das erste Türchen öffnet am 1. Dezember."}
        </p>
      ) : (
        days
          .slice()
          .reverse()
          .map((day) => <DayTable date={day.data.date} prizes={day.data.prizes} />)
      )
    }
  </main>

</Layout>

<style>
  /* Fir green with scattered snowflakes, two layers offset for variety. */
  .hero-band {
    background-color: var(--color-oac-pine);
    background-image:
      radial-gradient(circle, rgb(255 255 255 / 0.55) 1.5px, transparent 2.5px),
      radial-gradient(circle, rgb(255 255 255 / 0.35) 1px, transparent 2px);
    background-size:
      46px 46px,
      29px 29px;
    background-position:
      0 0,
      13px 17px;
  }

  .door {
    position: relative;
    aspect-ratio: 1;
    perspective: 600px;
    border-radius: 4px;
  }

  /* The light behind an opened door. */
  .door-open {
    background: radial-gradient(circle at 60% 50%, #fff6b0, var(--color-oac-orange) 75%);
  }

  .door > a,
  .door-link {
    position: relative;
    display: block;
    height: 100%;
    border-radius: 4px;
  }

  .door > a:focus-visible {
    outline: 3px solid var(--color-oac-berry);
    outline-offset: 3px;
  }

  .door-panel {
    position: relative;
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: var(--color-oac-navy);
    color: var(--color-oac-yellow);
    /* A serif like the numbers printed on the calendar. */
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    font-variant-numeric: oldstyle-nums;
    transform-origin: left center;
    transition: transform 0.5s ease-in-out;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
  }

  /* Perforation: a dotted cut line just inside the door's edge. */
  .door-panel::before {
    content: "";
    position: absolute;
    inset: 5px;
    border: 2px dotted rgb(255 255 255 / 0.45);
    border-radius: 2px;
  }

  .door-open .door-panel {
    transform: rotateY(-62deg);
    box-shadow: 4px 2px 8px rgb(0 0 0 / 0.3);
  }

  .door-open a:hover .door-panel,
  .door-open a:focus-visible .door-panel {
    transform: rotateY(-75deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .door-panel {
      transition: none;
    }
  }
</style>
