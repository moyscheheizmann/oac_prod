---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ottenser Adventskalender",
  description =
    "Der Ottenser Adventskalender – prall gefüllt mit tollen Preisen von Ottenser Geschäften und aus ganz Hamburg. Eine gemeinnützige Aktion der aTriBühne e.V. und KIDS Hamburg e.V.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-oac-paper">
    <slot />
  </body>
</html>
