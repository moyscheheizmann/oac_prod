---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LosnummerSearch from "../components/LosnummerSearch.astro";
import { getOpenDays } from "../lib/calendar";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ottenser Adventskalender",
  description =
    "Der Ottenser Adventskalender – prall gefüllt mit tollen Preisen von Ottenser Geschäften und aus ganz Hamburg. Eine gemeinnützige Aktion der aTriBühne e.V. und KIDS Hamburg e.V.",
} = Astro.props;

// The header's "Losnummer eingeben" button lives on every page, so the dialog
// it opens has to as well — otherwise the button is dead on the subpages.
const days = await getOpenDays();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-oac-paper">
    <SiteHeader />
    <LosnummerSearch days={days} />
    <slot />
    <SiteFooter />
  </body>
</html>
